{
  "$defs": {
    "AppointmentAssessment": {
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 12,
          "title": "Evidence Refs",
          "type": "array"
        },
        "counterevidence": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 12,
          "title": "Counterevidence",
          "type": "array"
        },
        "unresolved": {
          "items": {
            "maxLength": 6000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Unresolved",
          "type": "array"
        },
        "value": {
          "enum": [
            "new",
            "renewed",
            "unknown"
          ],
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "rationale",
        "evidence_refs",
        "counterevidence",
        "unresolved",
        "value"
      ],
      "title": "AppointmentAssessment",
      "type": "object"
    },
    "AttendanceAssessment": {
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 12,
          "title": "Evidence Refs",
          "type": "array"
        },
        "counterevidence": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 12,
          "title": "Counterevidence",
          "type": "array"
        },
        "unresolved": {
          "items": {
            "maxLength": 6000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Unresolved",
          "type": "array"
        },
        "value": {
          "enum": [
            "known",
            "unknown"
          ],
          "title": "Value",
          "type": "string"
        },
        "period_start": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Period End",
          "type": "string"
        },
        "all_board_meetings_covered": {
          "title": "All Board Meetings Covered",
          "type": "boolean"
        },
        "service_intervals": {
          "items": {
            "$ref": "#/$defs/DutyInterval"
          },
          "maxItems": 20,
          "title": "Service Intervals",
          "type": "array"
        },
        "legal_suspension_intervals": {
          "items": {
            "$ref": "#/$defs/DutyInterval"
          },
          "maxItems": 20,
          "title": "Legal Suspension Intervals",
          "type": "array"
        },
        "meetings": {
          "items": {
            "$ref": "#/$defs/BoardMeetingAttendance"
          },
          "maxItems": 200,
          "title": "Meetings",
          "type": "array"
        },
        "exception": {
          "$ref": "#/$defs/AttendanceException"
        }
      },
      "required": [
        "rationale",
        "evidence_refs",
        "counterevidence",
        "unresolved",
        "value",
        "period_start",
        "period_end",
        "all_board_meetings_covered",
        "service_intervals",
        "legal_suspension_intervals",
        "meetings",
        "exception"
      ],
      "title": "AttendanceAssessment",
      "type": "object"
    },
    "AttendanceException": {
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 12,
          "title": "Evidence Refs",
          "type": "array"
        },
        "counterevidence": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 12,
          "title": "Counterevidence",
          "type": "array"
        },
        "unresolved": {
          "items": {
            "maxLength": 6000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Unresolved",
          "type": "array"
        },
        "value": {
          "enum": [
            "accepted",
            "rejected",
            "unknown"
          ],
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "rationale",
        "evidence_refs",
        "counterevidence",
        "unresolved",
        "value"
      ],
      "title": "AttendanceException",
      "type": "object"
    },
    "BoardMeetingAttendance": {
      "additionalProperties": false,
      "properties": {
        "meeting_id": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Meeting Id",
          "type": "string"
        },
        "date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Date",
          "type": "string"
        },
        "attendance": {
          "enum": [
            "present",
            "absent",
            "unknown"
          ],
          "title": "Attendance",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "meeting_id",
        "date",
        "attendance",
        "evidence_refs"
      ],
      "title": "BoardMeetingAttendance",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 3000,
          "minLength": 12,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "quote"
      ],
      "title": "Citation",
      "type": "object"
    },
    "DutyInterval": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "End",
          "type": "string"
        },
        "rationale": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "start",
        "end",
        "rationale",
        "evidence_refs"
      ],
      "title": "DutyInterval",
      "type": "object"
    },
    "IndependenceAssessment": {
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 12,
          "title": "Evidence Refs",
          "type": "array"
        },
        "counterevidence": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 12,
          "title": "Counterevidence",
          "type": "array"
        },
        "unresolved": {
          "items": {
            "maxLength": 6000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Unresolved",
          "type": "array"
        },
        "value": {
          "enum": [
            "concern",
            "no_concern",
            "no_public_concern",
            "unknown"
          ],
          "title": "Value",
          "type": "string"
        },
        "information_gaps": {
          "items": {
            "$ref": "#/$defs/PublicInformationGap"
          },
          "maxItems": 12,
          "title": "Information Gaps",
          "type": "array"
        }
      },
      "required": [
        "rationale",
        "evidence_refs",
        "counterevidence",
        "unresolved",
        "value"
      ],
      "title": "IndependenceAssessment",
      "type": "object"
    },
    "PublicInformationGap": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "kind": {
          "const": "private_employment_advisory_compensation",
          "title": "Kind",
          "type": "string"
        },
        "availability": {
          "enum": [
            "not_found_in_reviewed_public_sources",
            "explicitly_nonpublic"
          ],
          "title": "Availability",
          "type": "string"
        },
        "search_scope": {
          "items": {
            "maxLength": 6000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Search Scope",
          "type": "array"
        },
        "disposition": {
          "const": "follow_up_only",
          "title": "Disposition",
          "type": "string"
        }
      },
      "required": [
        "question",
        "kind",
        "availability",
        "search_scope",
        "disposition"
      ],
      "title": "PublicInformationGap",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "maxLength": 6000,
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "evaluator": {
      "maxLength": 6000,
      "minLength": 1,
      "title": "Evaluator",
      "type": "string"
    },
    "appointment": {
      "$ref": "#/$defs/AppointmentAssessment"
    },
    "independence": {
      "$ref": "#/$defs/IndependenceAssessment"
    },
    "attendance": {
      "anyOf": [
        {
          "$ref": "#/$defs/AttendanceAssessment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "task_id",
    "evaluator",
    "appointment",
    "independence"
  ],
  "title": "GuidelineAssessment",
  "type": "object"
}

    DOC_notice["주주총회 소집공고"]:::doc
    DOC_result["주주총회 결과<br/>(의결권 행사결과)"]:::doc
    DOC_tsresult["자기주식 취득·처분<br/>결과보고서 / 소각결정"]:::doc
    DOC_divdec["현금·현물배당 결정"]:::doc
    DOC_order["단일판매·공급계약 체결"]:::doc
    DOC_gov["기업지배구조보고서"]:::doc
    DOC_valueup["기업가치제고계획 (밸류업)"]:::doc
    DOC_riskI["중대재해·횡령배임·생산중단"]:::doc
    DOC_lawsuit["경영권분쟁소송 제기"]:::doc

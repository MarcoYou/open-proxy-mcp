    DOC_5pct --> DA_5dyn["5% 보유 동학 (매집·목적 전환)"]:::data --> T_pcn
    DOC_ownchg --> DA_ownchg["최대주주 지분 변동"]:::data --> T_own
    DOC_proxy --> DA_proxyrec["위임장 권유 내역"]:::data --> T_pcn
    DOC_tender --> DA_tendercond["공개매수 조건"]:::data --> T_pcn

    %% ================= 공시 메타 =================
    TY5["공시 메타<br/>(원문 참조 없음)"]:::meta
    DOC_list["전체 공시 목록"]:::doc
    DOC_recept["rcept_no 메타"]:::doc

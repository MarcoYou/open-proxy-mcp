    T_dil["<b>dilutive_issuance</b><br/>희석 증권 발행"]:::tool
    T_res["<b>corporate_restructuring</b><br/>합병·분할·교환"]:::tool
    T_dea["<b>corporate_deals</b><br/>인수·매각"]:::tool
    T_ord["<b>order_contracts</b><br/>수주 추적"]:::tool
    T_not["<b>shareholder_meeting_notice</b><br/>주총 안건 (사전)"]:::tool
    T_adv["<b>proxy_advise_before_meeting</b><br/>의결권 권고 (사전)"]:::tool
    T_rslt["<b>shareholder_meeting_results</b><br/>주총 결과 (사후)"]:::tool

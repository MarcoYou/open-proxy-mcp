    DOC_notice --> DA_agenda["안건·이사후보·보수한도·정관변경"]:::data --> T_not
    DOC_notice --> DA_advise["안건 적법성·후보 평가 → 찬반 권고"]:::data --> T_adv
    DOC_result --> DA_vote["안건별 가결/부결·찬반율"]:::data --> T_rslt
    DOC_tsresult --> DA_tsactual["실제 취득·처분 수량·소각"]:::data --> T_tre
    DOC_divdec --> DA_dps["DPS·배당금총액·기준일"]:::data --> T_div
    DOC_order --> DA_contract["계약금액·매출대비%·상대방"]:::data --> T_ord
    DOC_gov --> DA_gov15["15개 핵심지표 준수율"]:::data --> T_gov

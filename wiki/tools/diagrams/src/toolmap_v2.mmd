    T_cmp["<b>company</b><br/>진입·식별"]:::tool
    T_evd["<b>evidence</b><br/>출처 링크"]:::tool

    %% ================= 정기보고서 =================
    TY1["정기보고서"]:::ty
    DOC_periodic["사업보고서<br/>반기보고서<br/>분기보고서"]:::doc
    TY1 --> DOC_periodic
    DOC_periodic --> DA_fs["재무제표 (BS·IS·CF)"]:::data --> T_fin
    DOC_periodic --> DA_audit["감사의견"]:::data --> T_fin
    DOC_periodic --> DA_divtable["배당에 관한 사항"]:::data --> T_div
    DOC_periodic --> DA_majorholder["최대주주·특수관계인 현황"]:::data --> T_own
    DOC_periodic --> DA_shares["주식총수·자기주식 현황"]:::data --> T_own

    %% ================= 주요사항보고서 =================
    TY2["주요사항보고서<br/>(수시 결정공시)"]:::ty
    DOC_ts["자기주식 취득·처분·<br/>신탁계약 결정"]:::doc
    DOC_issue["유상증자·전환사채(CB)·<br/>신주인수권부사채(BW)·감자 결정"]:::doc
    DOC_merge["회사합병·분할·분할합병·<br/>주식교환·이전 결정"]:::doc
    DOC_deal["타법인주식·출자증권<br/>양수·양도 결정"]:::doc
    DOC_riskB["회생절차신청·부도·<br/>영업정지·해산사유 발생"]:::doc
    TY2 --> DOC_ts & DOC_issue & DOC_merge & DOC_deal & DOC_riskB
    DOC_ts --> DA_tscond["취득·처분·신탁 조건·규모"]:::data --> T_tre
    DOC_issue --> DA_issuecond["발행조건·잠재희석률·refixing"]:::data --> T_dil
    DOC_merge --> DA_mergeratio["합병비율·외부평가·매수청구권"]:::data --> T_res
    DOC_deal --> DA_dealterm["상대방·금액·자산대비%"]:::data --> T_dea
    DOC_riskB --> DA_riskB["사유·영향 (도산·정지)"]:::data --> T_rsk

    %% ================= 거래소 수시공시 =================

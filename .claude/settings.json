{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/wiki_drift_warn.sh\"",
            "if": "Bash(git commit*)",
            "timeout": 10,
            "statusMessage": "wiki 동기화 점검 중..."
          }
        ]
      }
    ]
  }
}

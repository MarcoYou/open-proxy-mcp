{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/live_pilot_diff_hook.sh\"",
            "timeout": 20,
            "statusMessage": "live ↔ pilot 차이 확인 중..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/wiki_drift_warn.sh\"",
            "if": "Bash(git commit*)",
            "timeout": 10,
            "statusMessage": "wiki 동기화 점검 중..."
          }
        ]
      }
    ]
  }
}
